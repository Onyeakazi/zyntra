PORT=5000

# Firebase Admin SDK Credentials
# (Obtain these from Firebase Console: Project Settings -> Service Accounts -> Generate new private key)
# Make sure to wrap the private key in quotes and preserve \n for literal newlines
FIREBASE_PROJECT_ID=zyntra-33112
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@zyntra-33112.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# SMTP Server Configurations
# (e.g. SMTP server from Mailtrap for sandbox testing, Gmail App Password, or SendGrid)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Zyntra Public Logo URL (Optional - defaults to Cloudinary logo placeholder)
LOGO_URL=https://res.cloudinary.com/dcazbfdaw/image/upload/v1779316398/yvfuxkltvwygkdbaqvo1.jpg
